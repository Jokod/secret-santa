###> docker compose prod ###
# Usage sur le serveur :
#   cp .env.prod.dist .env.local
#   # renseigner APP_SECRET et MYSQL_ROOT_PASSWORD
#   docker compose -f compose.prod.yaml --env-file .env.local up -d
#
# Au démarrage, l’app exécute sync-metadata + migrations + assets + cache:warmup.
# Le service worker consomme messenger async (emails).

APP_INSTANCE=prod
APP_IMAGE=ghcr.io/jokod/secret-santa
# APP_IMAGE_TAG=2.1.1
APP_PORT=8080

MYSQL_PORT=6950
MYSQL_DATABASE=santa
MYSQL_ROOT_PASSWORD=change_me
###< docker compose prod ###

###> symfony/framework-bundle ###
APP_SECRET=change_me_to_a_long_random_string
###< symfony/framework-bundle ###

###> symfony/routing ###
# URL publique de l’app (sans slash final)
DEFAULT_URI=https://santa.exemple.fr
###< symfony/routing ###

###> symfony/mailer ###
# Ex. SMTP : smtp://user:pass@smtp.example.com:587
MAILER_DSN=null://null
MAIL_FROM=noreply@santa.local
###< symfony/mailer ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###
