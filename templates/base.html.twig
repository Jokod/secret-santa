<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="referrer" content="no-referrer">
    <title>{% block title %}Secret Santa Familial{% endblock %}</title>
    <link rel="icon" href="{{ asset('favicon.ico') }}" sizes="any">
    <link rel="icon" href="{{ asset('favicon-32.png') }}" type="image/png" sizes="32x32">
    <link rel="icon" href="{{ asset('images/logo-mark.png') }}" type="image/png" sizes="192x192">
    <link rel="apple-touch-icon" href="{{ asset('images/apple-touch-icon.png') }}">
    {% block stylesheets %}{% endblock %}
    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body>
{% block header %}
    {% embed '_header.html.twig' with {
        brand_href: path('home'),
        brand_label: 'Secret Santa Familial'
    } %}
        {% block nav %}
            {% include '_nav.html.twig' %}
        {% endblock %}
    {% endembed %}
{% endblock %}

<main class="{% block main_class %}container-narrow{% endblock %}" style="padding: 1.5rem 0 2rem;">
    {% include '_flashes.html.twig' %}
    {% block body %}{% endblock %}
</main>

{% include '_footer.html.twig' %}
</body>
</html>
