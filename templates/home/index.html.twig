{% extends 'base.html.twig' %}

{% block title %}Secret Santa Familial{% endblock %}

{% block main_class %}layout-home{% endblock %}

{% block header %}
    {% embed '_header.html.twig' with {
        brand_href: path('home'),
        brand_label: 'Secret Santa Familial'
    } %}
        {% block nav %}
            {% include '_nav.html.twig' with {with_home: false} %}
        {% endblock %}
    {% endembed %}
{% endblock %}

{% block body %}
    {% include 'home/_hero.html.twig' %}

    <div class="container-narrow home-content">
        {% include 'home/_how_it_works.html.twig' %}
    </div>
{% endblock %}
