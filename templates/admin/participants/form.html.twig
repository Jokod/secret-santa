{% extends 'admin/base_admin.html.twig' %}

{% block title %}{{ title }} · Secret Santa{% endblock %}

{% block body %}
<div class="page-header">
    <div>
        <h1>{{ title }}</h1>
        <p class="page-lead">Nom et email doivent être uniques. Un lien magique sera généré automatiquement.</p>
    </div>
</div>

<div class="panel" style="max-width:560px;">
    {{ form_start(form) }}
        {{ form_row(form.name) }}
        {{ form_row(form.email) }}
        <div class="actions-row">
            <button class="btn btn-primary" type="submit">Enregistrer</button>
            <a class="btn btn-ghost" href="{{ path('admin_participants') }}">Annuler</a>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
