{% extends 'admin/base_admin.html.twig' %}

{% block title %}Configuration · Secret Santa{% endblock %}

{% block body %}
<div class="page-header">
    <div>
        <h1>Configuration de l’édition</h1>
        <p class="page-lead">Budget, dates, modèles d’emails et easter egg.</p>
    </div>
</div>

{% if locked %}
    {% include '_locked_banner.html.twig' with {message: 'Tirage actif : budget, dates et emails en lecture seule. L’easter egg reste modifiable.'} only %}
{% endif %}

{% include '_budget.html.twig' with {amount: settings.budgetMax} %}

<div class="panel">
    {{ form_start(form) }}
        <div class="form-section">
            <h2 class="form-section-title">Paramètres</h2>
            <div class="form-cols form-cols-2">
                {{ form_row(form.budgetMax) }}
            </div>
            <div class="form-cols form-cols-2">
                {{ form_row(form.eventDate) }}
                {{ form_row(form.drawDate) }}
            </div>
        </div>
        <div class="form-section">
            <h2 class="form-section-title">Emails</h2>
            <p class="help">Variables disponibles : {SANTA}, {TARGET}, {BUDGET}, {LINK}.</p>
            {{ form_row(form.welcomeEmailTemplate) }}
            {{ form_row(form.resultEmailTemplate) }}
            {{ form_row(form.reminderEmailTemplate) }}
        </div>
        <div class="form-section">
            <h2 class="form-section-title">Easter egg</h2>
            {% include 'admin/_easter_egg_explainer.html.twig' with {switch: form.easterEggEnabled} only %}
        </div>
        <div class="actions-row">
            <button class="btn btn-primary" type="submit">Enregistrer</button>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
