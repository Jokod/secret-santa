{% extends 'participant/base.html.twig' %}

{% block title %}Mon espace · {{ participant.name }}{% endblock %}

{% block body %}
{% import '_empty.html.twig' as ui %}

<div class="page-header">
    <div>
        <h1>Ton espace Secret Santa</h1>
        {% if settings.eventDate %}
            <p class="page-lead">Événement le {{ settings.eventDate|date('d/m/Y') }}</p>
        {% endif %}
        {% if settings.drawDate %}
            <p class="page-lead">Tirage prévu le {{ settings.drawDate|date('d/m/Y') }}</p>
        {% endif %}
    </div>
</div>

{% include '_budget.html.twig' with {amount: settings.budgetMax, hint: 'Maximum recommandé par souhait'} %}

{% if locked %}
<section class="panel">
    <h2>Messagerie</h2>
    <p class="help">Échange anonymement avec ta cible ou ton Santa. Les messages non lus apparaissent ici.</p>
    <div class="messaging-cards">
        {% if target %}
            <a class="messaging-card{% if unreadFromTarget > 0 %} has-unread{% endif %}" href="{{ path('participant_messages_target', {token: participant.tokenSecret}) }}">
                <div class="messaging-card-icon"><i class="fa-solid fa-gift" aria-hidden="true"></i></div>
                <div class="messaging-card-body">
                    <strong>Avec ta cible</strong>
                    <span class="help">{{ target.name }} · questions, précisions, remerciements</span>
                </div>
                {% if unreadFromTarget > 0 %}
                    <span class="status-badge status-badge-unread">{{ unreadFromTarget }} non lu{{ unreadFromTarget > 1 ? 's' : '' }}</span>
                {% else %}
                    <span class="help">Aucun non lu</span>
                {% endif %}
            </a>
        {% endif %}
        {% if participant.assignmentAsTarget %}
            <a class="messaging-card{% if unreadFromSanta > 0 %} has-unread{% endif %}" href="{{ path('participant_messages_santa', {token: participant.tokenSecret}) }}">
                <div class="messaging-card-icon"><i class="fa-solid fa-hat-wizard" aria-hidden="true"></i></div>
                <div class="messaging-card-body">
                    <strong>Avec ton Santa</strong>
                    <span class="help">Anonyme · réponses et précisions pour ton cadeau</span>
                </div>
                {% if unreadFromSanta > 0 %}
                    <span class="status-badge status-badge-unread">{{ unreadFromSanta }} non lu{{ unreadFromSanta > 1 ? 's' : '' }}</span>
                {% else %}
                    <span class="help">Aucun non lu</span>
                {% endif %}
            </a>
        {% endif %}
    </div>
</section>
{% endif %}

{% if target %}
<section class="panel wish-panel wish-panel-offer">
    <div class="wish-panel-header">
        <div class="wish-panel-heading">
            <span class="wish-panel-icon" aria-hidden="true"><i class="fa-solid fa-gift"></i></span>
            <div>
                <h2>Tu offres à {{ target.name }}</h2>
                <p class="help">Ses idées cadeau, classées par priorité. Le 1er choix est son préféré.</p>
            </div>
        </div>
        {% if target.wishes is not empty %}
            <span class="wish-count">{{ target.wishes|length }} idée{{ target.wishes|length > 1 ? 's' : '' }}</span>
        {% endif %}
    </div>

    {% if target.wishes is empty %}
        {{ ui.empty('fa-gift', 'Pas encore de souhaits', target.name ~ ' n’a pas encore rempli sa liste. Tu pourras lui écrire via la messagerie.', null, null) }}
    {% else %}
        <div class="wish-list" role="list">
            {% for w in target.wishes %}
                {% include 'participant/_wish_card.html.twig' with {
                    wish: w,
                    budgetMax: settings.budgetMax,
                    editable: false,
                    token: null,
                    editingWish: null,
                    variant: 'offer'
                } only %}
            {% endfor %}
        </div>
    {% endif %}
</section>
{% else %}
<section class="panel">
    <h2>En attendant le tirage</h2>
    <p class="help">Complète ta liste de souhaits. Tu découvriras ta cible après le lancement par l’organisateur.</p>
</section>
{% endif %}

{% set wishFormAttr = {
    'data-controller': 'wish-budget',
    'data-wish-budget-budget-max-value': settings.budgetMax,
    'data-action': 'submit->wish-budget#confirmIfOverBudget'
} %}

<section class="panel wish-panel wish-panel-own" id="mes-souhaits">
    <div class="wish-panel-header">
        <div class="wish-panel-heading">
            <span class="wish-panel-icon" aria-hidden="true"><i class="fa-solid fa-heart"></i></span>
            <div>
                <h2>Mes souhaits</h2>
                <p class="help">Aide ton Santa : plus c’est précis (lien, prix, priorité), mieux c’est.</p>
            </div>
        </div>
        {% if participant.wishes is not empty %}
            <span class="wish-count">{{ participant.wishes|length }} souhait{{ participant.wishes|length > 1 ? 's' : '' }}</span>
        {% endif %}
    </div>

    {% if participant.wishes is empty %}
        {{ ui.empty('fa-list', 'Aucun souhait pour l’instant', 'Ajoute quelques idées ci-dessous pour aider ton Santa.', null, null) }}
    {% else %}
        <div class="wish-list" role="list">
            {% for w in participant.wishes %}
                {% include 'participant/_wish_card.html.twig' with {
                    wish: w,
                    budgetMax: settings.budgetMax,
                    editable: true,
                    token: participant.tokenSecret,
                    editingWish: editingWish,
                    variant: 'own'
                } only %}
            {% endfor %}
        </div>
    {% endif %}

    <div class="wish-form-block" id="wish-form">
        {% if editingWish %}
            <h3 class="form-section-title">Modifier le souhait</h3>
            {{ form_start(wishForm, {action: path('participant_wish_edit', {token: participant.tokenSecret, id: editingWish.id}), attr: wishFormAttr}) }}
                {{ form_row(wishForm.title) }}
                {{ form_row(wishForm.description) }}
                <div class="form-cols form-cols-2">
                    {% include 'participant/_wish_price_field.html.twig' %}
                    {{ form_row(wishForm.preferenceOrder) }}
                </div>
                {{ form_row(wishForm.url) }}
                <div class="actions-row">
                    <button class="btn btn-primary" type="submit">Enregistrer</button>
                    <a class="btn btn-ghost" href="{{ path('participant_home', {token: participant.tokenSecret}) }}">Annuler</a>
                </div>
            {{ form_end(wishForm) }}
        {% else %}
            <h3 class="form-section-title">Ajouter un souhait</h3>
            {{ form_start(wishForm, {action: path('participant_wish_new', {token: participant.tokenSecret}), attr: wishFormAttr}) }}
                {{ form_row(wishForm.title) }}
                {{ form_row(wishForm.description) }}
                <div class="form-cols form-cols-2">
                    {% include 'participant/_wish_price_field.html.twig' %}
                    {{ form_row(wishForm.preferenceOrder) }}
                </div>
                {{ form_row(wishForm.url) }}
                <div class="actions-row">
                    <button class="btn btn-primary" type="submit">Ajouter un souhait</button>
                </div>
            {{ form_end(wishForm) }}
        {% endif %}
    </div>
</section>
{% if editingWish %}
    <script>
        document.getElementById('wish-form')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    </script>
{% endif %}
{% endblock %}
