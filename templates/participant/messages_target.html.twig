{% extends 'participant/base.html.twig' %}

{% block title %}Messagerie cible · {{ participant.name }}{% endblock %}

{% block body %}
<div class="page-header">
    <div>
        <h1>Messagerie avec ta cible</h1>
        <p class="page-lead">Tu écris à {{ target.name }} en tant que Santa : ton identité reste secrète.</p>
    </div>
    <a class="btn btn-ghost" href="{{ path('participant_home', {token: participant.tokenSecret}) }}"><i class="fa-solid fa-arrow-left"></i> Mon espace</a>
</div>

{% include '_budget.html.twig' with {amount: settings.budgetMax, hint: 'À respecter pour le cadeau de ' ~ target.name} %}

{% include 'participant/_chat_thread.html.twig' with {
    thread: thread,
    form: form,
    formAction: path('participant_messages_target', {token: participant.tokenSecret}),
    mercureTopic: mercureTopic,
    markReadUrlTemplate: markReadUrlTemplate,
    markReadCsrf: markReadCsrf,
    mineType: 'to_target',
    mineLabel: 'Toi (Santa)',
    theirsLabel: target.name,
    emptyText: 'Une question sur la taille, une préférence, un détail utile ?',
    submitLabel: 'Écrire à ma cible',
    submitClass: 'btn-secondary'
} only %}
{% endblock %}
