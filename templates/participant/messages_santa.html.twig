{% extends 'participant/base.html.twig' %}

{% block title %}Messagerie Santa · {{ participant.name }}{% endblock %}

{% block body %}
<div class="page-header">
    <div>
        <h1>Messagerie avec ton Santa</h1>
        <p class="page-lead">Échange anonyme : tu ne verras jamais qui t’offre un cadeau.</p>
    </div>
    <a class="btn btn-ghost" href="{{ path('participant_home', {token: participant.tokenSecret}) }}"><i class="fa-solid fa-arrow-left"></i> Mon espace</a>
</div>

{% include '_budget.html.twig' with {amount: settings.budgetMax} %}

{% include 'participant/_chat_thread.html.twig' with {
    thread: thread,
    form: form,
    formAction: path('participant_messages_santa', {token: participant.tokenSecret}),
    mercureTopic: mercureTopic,
    markReadUrlTemplate: markReadUrlTemplate,
    markReadCsrf: markReadCsrf,
    mineType: 'to_santa',
    mineLabel: 'Toi',
    theirsLabel: 'Ton Santa',
    emptyText: 'Ton Santa pourra te poser des questions ici.',
    submitLabel: 'Écrire à mon Santa',
    submitClass: 'btn-ghost'
} only %}
{% endblock %}
